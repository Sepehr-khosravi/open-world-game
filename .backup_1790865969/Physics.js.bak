import * as CANNON from 'cannon-es';

export class Physics {
  constructor() {
    /*
     * Gravity: -20 is the sweet spot.
     *   -10 = too floaty
     *   -30 = raycast vehicle breaks through ground
     */
    this.world = new CANNON.World({
      gravity: new CANNON.Vec3(0, -20, 0),
    });

    this.world.broadphase = new CANNON.SAPBroadphase(this.world);
    this.world.allowSleep = false;
    this.world.defaultContactMaterial.friction = 0.4;

    // Solver: 20 iterations for stable raycast
    this.world.solver.iterations = 20;
    this.world.solver.tolerance = 0.001;

    const groundMat = new CANNON.Material('ground');
    const playerMat = new CANNON.Material('player');

    this.groundMaterial = groundMat;
    this.playerMaterial = playerMat;

    this.world.addContactMaterial(
      new CANNON.ContactMaterial(groundMat, playerMat, {
        friction: 0.0,
        restitution: 0,
      })
    );

    // Main ground plane at y = 0
    const groundBody = new CANNON.Body({
      mass: 0,
      shape: new CANNON.Plane(),
    });
    groundBody.quaternion.setFromEuler(-Math.PI / 2, 0, 0);
    groundBody.position.set(0, 0, 0);
    this.world.addBody(groundBody);

    /*
     * Backup cushion: a thick Box right under the plane.
     * If raycast physics pushes something through y = 0,
     * this Box catches it before it enters the void.
     */
    const cushion = new CANNON.Body({ mass: 0 });
    cushion.addShape(new CANNON.Box(new CANNON.Vec3(600, 2, 600)));
    cushion.position.set(0, -2, 0);
    this.world.addBody(cushion);

    // Boundary walls (500m) — prevents leaving the world
    const mk = (x, z, rx, ry, rz) => {
      const b = new CANNON.Body({ mass: 0, shape: new CANNON.Plane() });
      b.position.set(x, 0, z);
      b.quaternion.setFromEuler(rx, ry, rz);
      this.world.addBody(b);
    };
    mk( 500, 0, 0, -Math.PI / 2, 0);
    mk(-500, 0, 0,  Math.PI / 2, 0);
    mk(0,  500, Math.PI / 2, 0, 0);
    mk(0, -500, -Math.PI / 2, 0, 0);
  }

  step(dt) {
    // 10 sub-steps for smooth vehicle physics
    this.world.step(1 / 60, Math.min(dt, 0.05), 10);
  }
}
